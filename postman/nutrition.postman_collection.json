{
  "info": {
    "_postman_id": "athletica-nutrition-collection",
    "name": "Nutrition Module",
    "description": "Athletica nutrition endpoints - food catalog, templates, plans, client views",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Food Catalog",
      "description": "Food library endpoints - available to any authenticated user",
      "item": [
        {
          "name": "List Foods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "categoryId", "value": "", "disabled": true },
                { "key": "isArchived", "value": "", "disabled": true },
                { "key": "minCalories", "value": "", "disabled": true },
                { "key": "maxCalories", "value": "", "disabled": true },
                { "key": "minProtein", "value": "", "disabled": true },
                { "key": "maxProtein", "value": "", "disabled": true },
                { "key": "minCarbs", "value": "", "disabled": true },
                { "key": "maxCarbs", "value": "", "disabled": true },
                { "key": "minFat", "value": "", "disabled": true },
                { "key": "maxFat", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Food by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/foods/{{foodId}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "foods", "{{foodId}}"]
            }
          }
        },
        {
          "name": "List Food Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/food-categories",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "food-categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Nutrition Templates",
      "description": "Template CRUD for coaches - create reusable meal plans",
      "item": [
        {
          "name": "Create Template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.template && jsonData.template.id) {",
                  "    pm.collectionVariables.set('nutritionTemplateId', jsonData.template.id);",
                  "    console.log('Saved nutritionTemplateId: ' + jsonData.template.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"High Protein Meal Plan\",\n  \"description\": \"4-week high protein nutrition plan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/nutrition/templates",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "templates"]
            }
          }
        },
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/templates?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "templates"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Template",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/templates/{{nutritionTemplateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "templates", "{{nutritionTemplateId}}"]
            }
          }
        },
        {
          "name": "Update Template",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"High Protein Meal Plan V2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/nutrition/templates/{{nutritionTemplateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "templates", "{{nutritionTemplateId}}"]
            }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/templates/{{nutritionTemplateId}}",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "templates", "{{nutritionTemplateId}}"]
            }
          }
        }
