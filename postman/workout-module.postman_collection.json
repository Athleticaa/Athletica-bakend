            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coach_client_id\": \"{{coachClientId}}\",\n  \"title\": \"January Program\",\n  \"description\": \"4-week program\",\n  \"start_date\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/templates/{{templateId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "templates",
                "{{templateId}}",
                "assign"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    if (jsonData.data.id) {",
                  "        pm.collectionVariables.set('planId', jsonData.data.id);",
                  "        console.log('Saved planId: ' + jsonData.data.id);",
                  "    }",
                  "    if (jsonData.data.days && jsonData.data.days.length > 0) {",
                  "        var firstDay = jsonData.data.days[0];",
                  "        pm.collectionVariables.set('planDayId', firstDay.id);",
                  "        console.log('Saved planDayId: ' + firstDay.id);",
                  "        if (firstDay.exercises && firstDay.exercises.length > 0) {",
                  "            pm.collectionVariables.set('planExerciseId', firstDay.exercises[0].id);",
                  "            console.log('Saved planExerciseId: ' + firstDay.exercises[0].id);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
